# Copia in .env ed esporta nell'ambiente PRIMA di avviare in live.
# In modalità paper NESSUNA di queste variabili è necessaria.

# API key dell'exchange (crea key con permessi SOLO trade, MAI withdrawal,
# e restringi per IP dal pannello dell'exchange)
MIROFISH_API_KEY=
MIROFISH_API_SECRET=

# Interruttore di sicurezza: il motore rifiuta mode:live senza questo consenso
# esplicito. Impostalo solo quando hai validato la strategia per settimane
# in paper e sul testnet, e solo con capitale che puoi permetterti di perdere.
MIROFISH_I_UNDERSTAND_THE_RISKS=
